DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oneforall_social
PORT=3000

# OAuth 2.1 protection for MCP and REST. Keep false until the identity provider
# and the ChatGPT OAuth connection have been tested end to end.
AUTH_ENABLED=false
AUTH_ISSUER=https://YOUR_TENANT.auth0.com/
AUTH_AUDIENCE=https://social-manager.ocloud.click
AUTH_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
AUTH_EMAIL_CLAIM=https://oneforall.ocloud.click/email
MCP_RESOURCE_URL=https://social-manager.ocloud.click
ALLOWED_EMAILS=wilson.meza@gmail.com,agency.oneforall@gmail.com

# Optional: required only for creating a new Google Calendar per client from the backend.
# Use an OAuth refresh token authorized for Google Calendar write access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
