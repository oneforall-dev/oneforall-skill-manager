PORT=8787
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/oneforall_social
TOKEN_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

# Instagram API + OAuth (Instagram API with Instagram Login)
META_GRAPH_BASE=https://graph.instagram.com
META_GRAPH_VERSION=v24.0
# Emergency kill switch. Leave true to expose Trial Reel publishing.
INSTAGRAM_TRIAL_REELS_ENABLED=true
INSTAGRAM_APP_ID=REPLACE_ME
INSTAGRAM_APP_SECRET=REPLACE_ME
INSTAGRAM_REDIRECT_URI=https://social.example.com/oauth/instagram/callback
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_LONG_TOKEN_URL=https://graph.instagram.com/access_token
INSTAGRAM_REFRESH_TOKEN_URL=https://graph.instagram.com/refresh_access_token

# Cloudflare R2
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=oneforall-social-media
# Public custom domain or R2 public bucket URL. Instagram must be able to fetch it without authentication.
R2_PUBLIC_BASE_URL=https://media.example.com

SCHEDULER_INTERVAL_MS=30000
TOKEN_REFRESH_INTERVAL_MS=43200000
TOKEN_REFRESH_BEFORE_DAYS=10

# Auditor execution visibility. After this bounded wait, missing evidence is
# reported as AUDITOR_NOT_EXECUTED instead of remaining silently pending.
AUDITOR_EXECUTION_TIMEOUT_MS=900000
